{
  "description": "Codex lifecycle hooks generated from appsec.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import base64,json;p=base64.b64decode('').decode();print(json.dumps({'hookSpecificOutput':{'hookEventName':'PostToolUse','additionalContext':p}}))\"",
            "timeout": 10,
            "statusMessage": "Loading plugin guidance"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
